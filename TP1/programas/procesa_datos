#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>
#include <string.h>

int main (int argc, char *argv[]){
	if (argc != 3){
		fprintf(stderr, "Uso incorrecto del ejecutable, se espera archivo seguido de area\n");
		return 1;
	}
	
	if(strcmp(argv[2], "AREA0") != 0 && strcmp(argv[2], "AREA1")!=0 && strcmp(argv[2], "AREA2")!= 0){
		fprintf(stderr, "Error, area incorrecta\n");
		return 1;
	}
	
	int pipefd[2];
	if(pipe(pipefd) == -1){
		perror("Error al crear la tuberia con pipe()");
		return 1;
	}
	
	pid_t pid1=fork();
	if(pid1 == -1) {
		perror("Error al realizar el fork() del hijo 1");
		return 1;
	}
	//pint1 == 0
	if (pid1 == 0){
		close(pipefd[0]);
		printf("HIJO1_1 PID: %d, PPID: %d\n", getpid(), getppid());
		
		int fd = open(argv[1], O_RDONLY);
		if (fd == -1){
			perror("Error al abrir el archivo en hijo 1");
			return 1;
		}
	
	
		int cantidad=0;
		char buffer[1024];
		char linea[256];
		int idx = 0;
		ssize_t bytes;

		while ((bytes = read(fd, buffer, sizeof(buffer))) > 0){
			for(size_t i=0; i<bytes; i++){
				if(buffer[i] == '\n'){
					linea[idx] = '\0';
					if (strstr(linea, argv[2]) != NULL){
						cantidad++;
					}
					idx=0;
				}else {
					if (idx < (int)sizeof(linea) -1) {
						linea[idx++] = buffer[i];
					}
				}
				
			}
		}
		close(fd);

		if (write(pipefd[1], &cantidad, sizeof(cantidad)) == -1) {
			perror("Error al escribir en la tuberia");
			return 1;
		}
		close(pipefd[1]);
		return 0; //Fin del hijo
	}
	
	pid_t pid2 = fork();
	if (pid2 == -1) {
		perror("Error al ejecutar fork() para el hijo 2");
		return 1;
	}
	
	if (pid2 == 0) {
		close(pipefd[0]);
		close(pipefd[1]);

		int fd_out = open ("resultados/exec_resultado.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
		if (fd_out == -1){
			perror("Error al ejecutar dup2()");
			close(fd_out);
			return 1;
		}

		if (dup2(fd_out, STDOUT_FILENO) == -1){
			perror("Error al ejecutar dup2()");
			close(fd_out);
			return 1;
		}
		close(fd_out);
		
		char *args[] = {"grep", argv[2], argv[1], NULL};
		execvp("grep", args);
		perror("Error en la ejecucion de execvp()");
		return 1; //Termina el hijo 2 por fallo
	}
	
	close(pipefd[1]);
	
	int cant_recibida=0;
	if (read(pipefd[0], &cant_recibida, sizeof(cant_recibida)) == -1){
		perror("Error al leer de la tuberia en el padre");
	}
	close(pipefd[0]);
	
	waitpid(pid1, NULL, 0);
	waitpid(pid2, NULL, 0);
	
	printf("Cantidad recibida del hijo: %d\n", cant_recibida);
	return 0; //Fin padre, fin final
}
